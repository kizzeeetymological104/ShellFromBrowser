# ============================================
# ShellFromBrowser — Environment Variables
# ============================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to git (listed in .gitignore)

# ============================================
# Backend Configuration
# ============================================
# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_ENV=development  # development | staging | production

# WebSocket
WS_MAX_CONNECTIONS=100
WS_RATE_LIMIT_PER_SECOND=10
WS_IDLE_TIMEOUT_MINUTES=30

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=CHANGE_ME_RANDOM_256_BIT_KEY
JWT_ACCESS_TOKEN_DURATION=15m
JWT_REFRESH_TOKEN_DURATION=168h  # 7 days
JWT_ISSUER=shellfrombroswer
JWT_AUDIENCE=shellfrombroswer-users

# ============================================
# Redis (Session Store)
# ============================================
REDIS_MODE=sentinel  # standalone | sentinel | cluster
REDIS_MASTER_NAME=mymaster
REDIS_SENTINELS=localhost:26379,localhost:26380,localhost:26381
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10

# ============================================
# PostgreSQL (Audit Logs)
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shellfrombroswer
POSTGRES_USER=sfb_admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_SSL_MODE=require  # disable | require | verify-full
POSTGRES_MAX_CONNECTIONS=20

# ============================================
# Docker (Shell Executor)
# ============================================
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_IMAGE=shellfrombroswer/shell-executor:latest
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=0.5
DOCKER_NETWORK_MODE=bridge

# ============================================
# Security
# ============================================
# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://shellfrombroswer.local
CORS_ALLOWED_METHODS=GET,POST,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Rate Limiting
RATE_LIMIT_GLOBAL_PER_MINUTE=1000
RATE_LIMIT_PER_USER_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_IP_PER_HOUR=20

# Input Sanitization
INPUT_MAX_LENGTH=4096
INPUT_ALLOWED_CHARS_REGEX=^[a-zA-Z0-9 ._\-/]*$

# ============================================
# Monitoring (Prometheus)
# ============================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_METRICS_PATH=/metrics

# ============================================
# Logging
# ============================================
LOG_LEVEL=info  # debug | info | warn | error
LOG_FORMAT=json  # json | text
LOG_OUTPUT=stdout  # stdout | file
LOG_FILE_PATH=/var/log/shellfrombroswer/app.log

# ============================================
# Frontend (React)
# ============================================
REACT_APP_API_BASE_URL=http://localhost:8080
REACT_APP_WS_URL=ws://localhost:8080/ws
REACT_APP_ENV=development

# ============================================
# GDPR Compliance
# ============================================
GDPR_IP_ANONYMIZATION_DAYS=30
GDPR_AUDIT_LOG_RETENTION_DAYS=365
GDPR_EXPORT_FORMAT=json  # json | csv

# ============================================
# Feature Flags (Phase 2-3)
# ============================================
FEATURE_MULTI_TABS=false
FEATURE_SESSION_RECORDING=false
FEATURE_OAUTH2_SSO=false
FEATURE_MFA=false
FEATURE_RBAC=false
